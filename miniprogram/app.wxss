page{background:#f6f3eb;color:#192e28;font-family:-apple-system,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.75}view,text,input,picker,button{box-sizing:border-box}.page{padding:32rpx 34rpx 60rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#637267}.title{font-family:Georgia,"Songti SC",serif;font-size:55rpx;line-height:1.45;font-weight:500;margin:20rpx 0}.subtle{color:#637267;font-size:24rpx}.primary{background:#244d40;color:#f6f3eb;border-radius:12rpx;font-size:27rpx;padding:7rpx 24rpx;margin:30rpx 0 12rpx}.primary::after,button::after{border:none}.secondary{background:#e5eadf;color:#244d40;border-radius:10rpx;font-size:24rpx;margin:12rpx 0}.card{background:#fffefa;border:1rpx solid #d9ddcf;border-radius:16rpx;padding:30rpx;margin:22rpx 0}.card-title{font:38rpx Georgia,"Songti SC",serif;margin:6rpx 0 15rpx}.tag{display:inline-block;font-size:20rpx;background:#eee8da;color:#79532d;padding:4rpx 12rpx;border-radius:5rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.small{font-size:21rpx;color:#637267}.field{margin:24rpx 0}.field-label{font-size:24rpx;color:#4d6054;margin-bottom:10rpx}.picker,input{background:#fffefa;border:1rpx solid #d9ddcf;border-radius:10rpx;padding:16rpx 20rpx;min-height:82rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{border:1rpx solid #d9ddcf;border-radius:40rpx;padding:10rpx 27rpx;background:#fffefa;font-size:24rpx}.chip.selected{background:#244d40;color:#f6f3eb;border-color:#244d40}.notice{background:#ece9dc;border-radius:12rpx;padding:24rpx;margin:20rpx 0;font-size:23rpx;color:#637267}.link{color:#244d40;font-size:23rpx;padding:12rpx 0}.error{color:#924c34;font-size:24rpx;padding:20rpx;background:#efe1d5;border-radius:10rpx;margin:20rpx 0}.two-buttons{display:flex;gap:15rpx}.two-buttons button{flex:1}.hero-image{width:100%;height:400rpx;border-radius:12rpx 100rpx 12rpx 12rpx;margin:20rpx 0}.divider{height:1rpx;background:#d9ddcf;margin:30rpx 0}.muted-btn{background:transparent;color:#637267;font-size:22rpx}.stop-time{font:30rpx Georgia,serif;color:#b55637}.task{background:#edf1e6;padding:22rpx;border-radius:9rpx;margin:20rpx 0;font-size:24rpx}.chat-bubble{background:#fffefa;border:1rpx solid #d9ddcf;padding:24rpx;border-radius:12rpx;margin:15rpx 0;font-size:25rpx;white-space:pre-wrap}.cover{background:#244d40;color:#f6f3eb;padding:35rpx;border-radius:15rpx;margin:10rpx 0 25rpx}.cover .eyebrow,.cover .subtle{color:#cfddca}.source-item{font-size:22rpx;padding:18rpx 0;border-top:1rpx solid #d9ddcf;word-break:break-all}
