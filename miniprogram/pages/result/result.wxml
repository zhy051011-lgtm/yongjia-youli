<view class="page" wx:if="{{plan}}"><view class="cover"><view class="eyebrow">YOUR YONGJIA FIELD NOTES</view><view class="card-title">{{plan.title}}</view><view class="subtle">{{plan.profile.date}} · {{plan.profile.group}} · {{plan.profile.transport}}</view><view>{{plan.stops.length}} 个停留点 · {{plan.used}} 分钟已分配</view></view><view class="chips"><view class="chip" data-type="short" bindtap="change">压缩到 2 小时</view><view class="chip" data-type="slow" bindtap="change">少走一点路</view><view class="chip" data-type="rain" bindtap="change">找雨天备选</view></view><view class="notice" wx:if="{{changes.length}}"><view wx:for="{{changes}}" wx:key="*this">{{item}}</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="two-buttons"><button class="muted-btn" bindtap="weather">查出行日天气</button><button class="muted-btn" bindtap="copyPlan">复制旅行手册</button></view><view class="notice" wx:if="{{weather}}">{{weather}}</view><view wx:for="{{plan.stops}}" wx:key="id"><view wx:if="{{item.transfer}}" class="small">↓ 转场预留 {{item.transfer}} 分钟 · 实际耗时待核验</view><view class="card"><view class="stop-time">{{item.start}} — {{item.end}}</view><view class="card-title">{{item.name}}</view><view class="tag">{{item.stay}} 分钟建议停留 · 开放待确认</view><view class="subtle field">{{item.reason}}</view><view class="task">✳ 探索任务（产品策划）
{{item.task}}</view><view class="link" data-url="{{item.navigation}}" bindtap="copy">复制地图查询链接 ↗</view><view class="small" wx:for="{{item.confirm}}" wx:for-item="note" wx:key="*this">待确认：{{note}}</view><view class="source-item" wx:for="{{item.sources}}" wx:for-item="source" wx:key="url" data-url="{{source.url}}" bindtap="copy">{{source.title}} ↗
<view class="small">核验 {{source.checked}} · 点击复制来源</view></view><view class="link" data-type="remove" data-id="{{item.id}}" bindtap="change">移除这一站</view></view></view><view class="notice"><view>留白 {{plan.remaining}} 分钟</view><view wx:for="{{plan.breaks}}" wx:key="after">{{item.start}}–{{item.end}} {{item.label}}</view><view wx:for="{{plan.notices}}" wx:key="*this">· {{item}}</view></view><view class="card"><view class="card-title">这份行程如何安排</view><view class="small field" wx:for="{{plan.steps}}" wx:key="name"><view>✓ {{item.name}}</view><view>{{item.detail}}</view></view></view><view class="card"><view class="card-title">和文化管家聊聊</view><view class="small">需要在后端配置 DeepSeek；工具执行后会更新上方行程。</view><input placeholder="例如：只保留一个古村…" value="{{message}}" maxlength="1600" bindinput="input"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="send">发送 ↑</button><view wx:if="{{reply}}" class="chat-bubble">{{reply}}</view><view wx:for="{{aiSteps}}" wx:key="name" class="small">{{item.name}}：{{item.detail}}</view></view></view><view wx:else class="page notice">请先在“我的行程”中生成一份安排。</view>
