.assistant-page{padding-bottom:180rpx}
.chat-list{margin:30rpx 0}
.chat-row{display:flex;margin:20rpx 0}
.chat-row.user{justify-content:flex-end}
.bubble{max-width:78%;padding:22rpx 26rpx;border-radius:18rpx;font-size:26rpx;line-height:1.7;word-break:break-word}
.bubble.assistant{background:#fffefa;border:1rpx solid #d9ddcf;color:#192e28;border-radius:18rpx 18rpx 18rpx 4rpx}
.bubble.user{background:#244d40;color:#f6f3eb;border-radius:18rpx 18rpx 4rpx 18rpx}
.bubble.loading{color:#637267}
.steps-card{background:#ece9dc;border-radius:12rpx;padding:20rpx 24rpx;margin:16rpx 0}
.step-item{margin:6rpx 0}
.quick-chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:20rpx 0}
.quick-chips .chip{background:#fffefa;border:1rpx solid #d9ddcf;border-radius:40rpx;padding:12rpx 26rpx;font-size:24rpx;color:#244d40}
.input-bar{position:fixed;left:0;right:0;bottom:0;background:#f6f3eb;padding:20rpx 34rpx 50rpx;display:flex;gap:16rpx;align-items:center;border-top:1rpx solid #d9ddcf}
.chat-input{flex:1;background:#fffefa;border:1rpx solid #d9ddcf;border-radius:12rpx;padding:18rpx 22rpx;font-size:26rpx;min-height:84rpx}
.send-btn{background:#244d40;color:#f6f3eb;border-radius:12rpx;font-size:26rpx;padding:0 32rpx;height:84rpx;line-height:84rpx;margin:0}
.send-btn[disabled]{background:#a8b0a3;color:#f6f3eb}
